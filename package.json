{
  "name": "atlas-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @atlas/admin dev",
    "dev:async": "tsx scripts/dev-async.ts",
    "sandbox": "pnpm --filter @atlas/sandbox dev",
    "authoring": "pnpm --filter @atlas/authoring dev",
    "build": "pnpm --filter './apps/*' build",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tests/tsconfig.json",
    "typecheck:watch": "tsgo --noEmit -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "vitest run tests/parity",
    "test:parity:sim": "vitest run sim.test.ts",
    "test:parity:node": "vitest run node.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:sandbox": "pnpm --filter @atlas/sandbox test:e2e",
    "test:integration": "playwright test --config playwright.itest.config.ts",
    "bdd:clean": "tsx tests/bdd/scripts/clear-artifacts.ts",
    "bdd": "pnpm bdd:clean && tsx tests/bdd/scripts/run.ts on-failure on-failure",
    "bdd:debug": "pnpm bdd:clean && tsx tests/bdd/scripts/run.ts on-failure always",
    "bdd:all": "pnpm bdd:clean && tsx tests/bdd/scripts/run.ts always always",
    "bdd:report": "playwright show-report tests/bdd/report",
    "bdd:server": "pnpm exec bddgen --config playwright.bdd.server.config.ts && pnpm exec playwright test --config playwright.bdd.server.config.ts",
    "bdd:server:report": "playwright show-report tests/bdd/report-server",
    "lint": "eslint .",
    "lint:widgets": "eslint \"bundles/*/src/widgets/**/*.ts\"",
    "lint:knip": "knip",
    "lint:syncpack": "syncpack lint",
    "lint:markdown": "markdownlint-cli2",
    "lint:spectral": "spectral lint \"specs/schemas/contracts/*.schema.json\"",
    "lint:sql": "squawk adapters/node/src/migrations/**/*.sql",
    "lint:links": "lychee --config lychee.toml \"**/*.md\"",
    "lint:semgrep": "semgrep --config .semgrep/atlas-invariants.yml --error",
    "format": "biome format --write",
    "format:check": "biome format",
    "secrets:scan": "gitleaks detect --config .gitleaks.toml --no-git --redact",
    "vuln:scan": "osv-scanner --recursive --lockfile=pnpm-lock.yaml .",
    "coverage": "vitest run --coverage",
    "test:lint-rules": "pnpm -C packages/eslint-plugin-atlas-widgets test",
    "cedar:check": "tsx adapters/policy-cedar/bin/cedar-check.ts",
    "deps:check": "depcruise modules adapters apps packages ports",
    "deps:graph": "depcruise modules adapters apps packages ports --output-type html --output-to deps.html",
    "smtp:up": "podman compose -f infra/compose/compose.smtp4dev.yml up -d",
    "smtp:down": "podman compose -f infra/compose/compose.smtp4dev.yml down",
    "domain:add": "tsx scripts/atlas-domain.ts add",
    "domain:list": "tsx scripts/atlas-domain.ts list",
    "domain:disable": "tsx scripts/atlas-domain.ts disable",
    "tenant:add-admin": "tsx scripts/tenant-add-admin.ts",
    "atlasctl": "tsx apps/atlasctl/src/main.ts",
    "sync-openapi": "tsx packages/openapi/scripts/sync-openapi.ts",
    "e2e:smoke": "tsx scripts/e2e-smoke.ts",
    "safe": "tsx scripts/safe-pnpm.ts",
    "overseer:check": "tsx scripts/overseer-check.ts",
    "overseer:check:verbose": "tsx scripts/overseer-check.ts --verbose"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@atlas/eslint-plugin-widgets": "workspace:*",
    "@atlas/test-fixtures": "workspace:*",
    "@biomejs/biome": "^2.0.6",
    "@playwright/test": "^1.59.1",
    "@stoplight/spectral-cli": "^6.14.2",
    "@types/estree": "^1.0.8",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "@vitest/coverage-v8": "^4.1.5",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "idb": "^8.0.0",
    "jiti": "^2.6.1",
    "knip": "^5.39.0",
    "lefthook": "^1.7.22",
    "linkedom": "^0.18.0",
    "markdownlint-cli2": "^0.18.1",
    "playwright-bdd": "^8.5.0",
    "postgres": "^3.4.5",
    "syncpack": "^13.0.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
