{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "seed.scenario.v1",
  "title": "SeedScenario",
  "description": "A scenario in the seed corpus. Ordered list of ScenarioSteps the runner submits through IntentDriver. See specs/crosscut/seed-corpus.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioId", "steps"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable id. Fixed scenarios use a kebab-case slug; materialized scenarios use the axis-id grammar from specs/crosscut/scenario-fuzzing.md §5."
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true,
      "maxItems": 32
    },
    "apply": {
      "type": "array",
      "description": "FixtureRefs whose steps are prepended (in order) to this scenario's steps. Recursive composition is depth-limited at runtime (max 8).",
      "items": { "$ref": "#/definitions/FixtureRef" },
      "maxItems": 32
    },
    "axisBindings": {
      "type": "object",
      "description": "Present on materialized scenarios. Keys are axis names; values are stringified axis values. See scenario-fuzzing.md §5.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/definitions/ScenarioStep" },
      "minItems": 1,
      "maxItems": 1024
    }
  },
  "definitions": {
    "FixtureRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "contentHash"],
      "properties": {
        "fixtureId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9/_-]{0,127}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ScenarioStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "intent"],
      "properties": {
        "stepId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
        },
        "intent": {
          "$ref": "event-envelope.v1#",
          "description": "An IntentEnvelope (the payload field in particular is action-specific and validated separately by the registered intent schema)."
        },
        "asTenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Logical tenant handle the runner resolves to a tenantId at submit time."
        },
        "asPrincipal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Logical principal handle the runner resolves to a principalId at submit time."
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": { "type": "boolean" },
            "errorCode": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
            }
          }
        }
      }
    }
  }
}
