{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Was ["vitest/globals"] — vitest was removed in favour of the @atlas/test
    // (node:test) runner, leaving a dangling type-lib reference that broke
    // `pnpm typecheck` (TS2688) AND silently dropped the base config's node
    // types (a child `types` array replaces, not merges). Tests import
    // { describe, it, expect } explicitly from @atlas/test, so no test globals
    // are needed here. Restored to node. (ADR 0016 enablement.)
    "types": ["node"]
    // Workspace package paths intentionally NOT mapped here. pnpm symlinks
    // each declared dep into the importer's `node_modules/`; TypeScript's
    // `moduleResolution: "bundler"` walks that the same way Node does. A
    // global `paths` map for `@atlas/*` masks missing `package.json`
    // dependencies — undeclared imports compile but explode at runtime.
    // If you genuinely need an alias for non-package contexts (e.g.,
    // tests/parity/), add it to that file's tsconfig or a vitest alias,
    // not to this root.
  },
  "include": [
    "global.d.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "modules/*/src/**/*.ts",
    "modules/*/test/**/*.ts",
    "adapters/*/src/**/*.ts",
    "adapters/*/test/**/*.ts",
    "ports/src/**/*.ts",
    "ports/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/tests/**/*.ts",
    "apps/*/vite.config.ts",
    "apps/*/playwright.config.ts",
    "bundles/*/src/**/*.ts",
    "bundles/*/test/**/*.ts",
    // tests/** has its own tsconfig (tests/tsconfig.json) with workspace
    // path aliases, because tests/parity and tests/bdd live outside any
    // pnpm package and need aliases to resolve @atlas/* imports.
    // Excluded here so the root config stays strictly workspace-package
    // scoped — and so the @atlas/<pkg> dependency-declaration discipline
    // is enforced for real packages.
    "playwright.config.ts",
    "playwright.itest.config.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/test-results",
    "**/playwright-report"
  ]
}
